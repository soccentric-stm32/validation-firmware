# EditorConfig: https://editorconfig.org
# Matches the project style enforced by .clang-format / .clang-tidy.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{md,json,yml,yaml}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{py,sh}]
indent_size = 4
